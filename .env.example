# Pramaan DMS environment template. Committed to git with placeholders only.
# Do not edit by hand: run `python tools/setup_env.py`, which copies this file to .env
# (git-ignored) and replaces every "change-me" with a new random secret. The app refuses
# to start while any "change-me" value is left.

# General
PRAMAAN_ENV=dev
PRAMAAN_LOG_LEVEL=INFO
PRAMAAN_EXPOSE_API_DOCS=false
PRAMAAN_BUILD_COMMIT=unknown

# Where the web UI listens on the host. 127.0.0.1 keeps it off the network; set to
# 0.0.0.0 only when a phone on the same network must reach it (QR verify demo).
PRAMAAN_HTTP_BIND=127.0.0.1
PRAMAAN_HTTP_PORT=8080

# PostgreSQL: superuser (init only), schema owner (migrations only), app role (runtime)
POSTGRES_PASSWORD=change-me
PRAMAAN_DB_OWNER_PASSWORD=change-me
PRAMAAN_DB_APP_PASSWORD=change-me

# Valkey (job queue)
VALKEY_PASSWORD=change-me

# SeaweedFS S3: admin identity (bucket setup, Phase 5) and app identity (runtime)
PRAMAAN_S3_ADMIN_ACCESS_KEY=change-me
PRAMAAN_S3_ADMIN_SECRET_KEY=change-me
PRAMAAN_S3_APP_ACCESS_KEY=change-me
PRAMAAN_S3_APP_SECRET_KEY=change-me

# Originals bucket. Every original is locked in COMPLIANCE mode for this many days: no
# one can delete it or shorten the lock, not even the storage admin. On a dev machine the
# only way to clear stored files is to remove the seaweeddata volume.
PRAMAAN_S3_BUCKET=pramaan-originals
PRAMAAN_RETENTION_DAYS=3650

# Development-only identity from X-Pramaan-User and X-Pramaan-Role headers, until real
# login exists (Phase 16). Anyone who can reach the API could claim any user, so keep it
# false except for local testing. The app refuses true unless PRAMAAN_ENV is dev or test.
PRAMAAN_DEV_IDENTITY=false

# OpenBao dev-mode root token (demo only; Phase 18 switches the app to scoped tokens)
PRAMAAN_OPENBAO_TOKEN=change-me
