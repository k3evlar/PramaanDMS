# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# FIR-Tamper dataset: generated files are rebuilt from the seed
# (.venv/Scripts/python -m ml.data.generator.build --out dataset).
# Keep README, templates and label files; ignore the large generated folders.
dataset/base_docs/
dataset/tampered/
dataset/captures/
dataset_build.log

# Local secrets and tools (generated, never committed)
.env
docker/secrets/
.tools/

# Frontend build output and dependencies
frontend/node_modules/
frontend/dist/

# FIR-Tamper v3 generated files (rebuilt from the seed, D95)
dataset_v3/base_docs/
dataset_v3/tampered/
dataset_v3/captures/

# Audit tool environment
analysis/dataset_audit/.venv/

# dataset_v2 (teammate's E0-E15 build): labels, annotations and manifests are committed;
# the PDFs, JSON sidecars and images are regenerated by scripts/generate_dataset_v2.py and
# scripts/make_capture_variants.py
dataset_v2/base_docs/
dataset_v2/tampered/
dataset_v2/captures/

# Separate environment for exact dataset rebuilds (ml/requirements-data.txt, D98)
.venv-data/
